{
  "name": "crystal-price-system",
  "version": "1.0.13",
  "description": "晶振物料报价记录查询系统",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n server,electron \"npm run dev:server\" \"npm run dev:electron\"",
    "dev:server": "node server/src/index.js",
    "dev:electron": "sleep 2 && electron .",
    "build": "cd client && npm run build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "sql.js": "^1.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
