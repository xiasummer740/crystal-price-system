{
  "name": "crystal-price-system",
  "version": "1.0.258",
  "description": "晶振物料报价记录查询系统",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "dev:server": "node server/src/index.js",
    "dev:electron": "electron .",
    "build": "cd client && npm run build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:installer": "npm run build && electron-builder --win nsis",
    "test:backend": "node --test tests/*.test.js",
    "test:frontend": "cd client && npx vitest run",
    "test": "npm run test:backend && npm run test:frontend",
    "test:e2e": "npx playwright test",
    "release": "powershell -ExecutionPolicy Bypass -File .\\scripts\\release.ps1"
  },
  "dependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "adm-zip": "^0.6.1",
    "call-bind-apply-helpers": "^1.0.2",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "pinyin-pro": "^3.29.5",
    "sql.js": "^1.11.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "build": {
    "appId": "com.crystal.price-system",
    "productName": "晶振报价管理系统",
    "directories": {
      "output": "dist-exe"
    },
    "publish": {
      "provider": "github",
      "owner": "xiasummer740",
      "repo": "crystal-price-system"
    },
    "files": [
      "!**/node_modules",
      "!build{,/**/*}",
      "!dist-exe{,/**/*}",
      "electron/**/*",
      "server/**/*",
      "!server/**/数据库{,/**/*}",
      "!server/**/data.db",
      "!server/.auth_token",
      "!server/.mcp.json",
      "!server/logs{,/**/*}",
      "!server/src/Excel备份{,/**/*}",
      "!server/.claude{,/**/*}",
      "!server/scripts{,/**/*}",
      "!server/模板{,/**/*}",
      "client/dist/**/*",
      "package.json",
      "dev-app-update.yml"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "win": {
      "icon": "client/public/SJK-256.png",
      "sign": false,
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "crystal-price-system-setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": 2052,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "shortcutName": "晶振报价管理系统"
    },
    "portable": {
      "artifactName": "晶振报价管理系统-便携版-v${version}.${ext}"
    },
    "asar": false,
    "extraResources": [
      {
        "from": "node_modules/archiver-utils",
        "to": "app/node_modules/archiver-utils"
      },
      {
        "from": "node_modules/call-bind-apply-helpers",
        "to": "app/node_modules/call-bind-apply-helpers"
      },
      {
        "from": "node_modules/encoding",
        "to": "app/node_modules/encoding"
      },
      {
        "from": "node_modules/es-abstract-get",
        "to": "app/node_modules/es-abstract-get"
      },
      {
        "from": "node_modules/iconv-lite",
        "to": "app/node_modules/iconv-lite"
      },
      {
        "from": "node_modules/side-channel-list",
        "to": "app/node_modules/side-channel-list"
      },
      {
        "from": "node_modules/side-channel-map",
        "to": "app/node_modules/side-channel-map"
      },
      {
        "from": "node_modules/side-channel-weakmap",
        "to": "app/node_modules/side-channel-weakmap"
      },
      {
        "from": "node_modules/tesseract.js-core",
        "to": "app/node_modules/tesseract.js-core"
      }
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "supertest": "^7.2.2"
  }
}