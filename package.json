{
  "name": "crystal-price-system",
  "version": "1.0.80",
  "description": "晶振物料报价记录查询系统",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "dev:server": "node server/src/index.js",
    "dev:electron": "electron .",
    "build": "cd client && npm run build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:installer": "npm run build && electron-builder --win nsis",
    "test:backend": "node --test tests/*.test.js",
    "test:frontend": "cd client && npx vitest run",
    "test": "npm run test:backend && npm run test:frontend",
    "test:e2e": "npx playwright test",
    "release": "powershell -ExecutionPolicy Bypass -File .\\scripts\\release.ps1"
  },
  "dependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "sql.js": "^1.11.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.crystal.price-system",
    "productName": "晶振报价管理系统",
    "directories": {
      "output": "dist-exe"
    },
    "publish": {
      "provider": "github",
      "owner": "xiasummer740",
      "repo": "crystal-price-system"
    },
    "files": [
      "!**/node_modules",
      "!build{,/**/*}",
      "!dist-exe{,/**/*}",
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "win": {
      "icon": "client/public/SJK-256.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "crystal-price-system-setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": 2052,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "portable": {
      "artifactName": "晶振报价管理系统-便携版-v${version}.${ext}"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "supertest": "^7.2.2"
  }
}
